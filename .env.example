# Copier en .env (`cp .env.example .env`) puis adapter. Valeurs de développement local uniquement.

# Source de données
API_BASE_URL=https://climato.chom.engineering
HISTORY_START=1990-01-01
# 0 = toutes les stations synop de métropole (~220). Mettre 40 sur une machine modeste.
MAX_STATIONS=0
API_WORKERS=3

# Data lake (MinIO)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Airflow (interface http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Ressources Spark (Docker Desktop : prévoir 8 Go de RAM)
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1536m
SPARK_DRIVER_MEMORY=1g

# ML
GBT_MAX_ITER=40
GBT_MAX_DEPTH=6
TRAIN_SAMPLE=1.0

# V2 (prévision infra-horaire) : token de l'Archive/Live API, délivré sur demande par Infoclimat
# INFOCLIMAT_TOKEN=
